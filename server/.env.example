# Copy this file to .env and fill in your values
PORT=5000
MONGODB_URI=                          # Leave blank to use in-memory MongoDB (dev/demo)
JWT_SECRET=change_this_to_a_secure_random_string
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Hints (Module 1 — Vishnuvardhan Nagarapu)
GEMINI_API_KEY=                       # Get from https://aistudio.google.com/app/apikey
HINT_POINT_COST=5                     # Points deducted per hint request
HINT_MAX_PER_QUESTION=3               # Max hints a team can request per question
HINT_MIN_ATTEMPTS=2                   # Wrong attempts required before hints unlock
